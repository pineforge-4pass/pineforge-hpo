{
  "schema_version": 1,
  "mode": "single_strategy",
  "strategies": [
    {
      "id": "threshold",
      "source": "../single_strategy/threshold.pine",
      "datasets": ["synthetic-1m"],
      "fixed_inputs": {},
      "strategy_overrides": {},
      "search_space": {
        "Entry Level": {"kind": "real", "low": 101, "high": 103, "step": 0.5},
        "Exit Level": {"kind": "real", "low": 98, "high": 100, "step": 0.5}
      }
    }
  ],
  "datasets": [
    {
      "id": "synthetic-1m",
      "ohlcv": "ohlcv.csv",
      "input_tf": "1",
      "script_tf": "1",
      "chart_timezone": "UTC"
    }
  ],
  "objective": {
    "kind": "expression",
    "direction": "maximize",
    "expression": "metrics.all.net_profit - 0.5 * metrics.equity.max_equity_drawdown",
    "constraints": ["metrics.all.num_trades >= 1"],
    "nan_policy": "fail_trial",
    "division_by_zero": "fail_trial"
  },
  "sampler": {"kind": "grid", "seed": 20260718, "trials": 25},
  "execution": {"workers": 2, "isolation": "threads"}
}

file(READ "${PFH_FLAGS_FILE}" PFH_FLAGS_TEXT)
string(SHA256 PFH_FLAGS_HASH "${PFH_FLAGS_TEXT}")
set(PFH_HEADER "#pragma once\n#define PFH_NUMERIC_BUILD_FLAGS_HASH \"${PFH_FLAGS_HASH}\"\n")
if(EXISTS "${PFH_FLAGS_HEADER}")
    file(READ "${PFH_FLAGS_HEADER}" PFH_PREVIOUS_HEADER)
    if(PFH_PREVIOUS_HEADER STREQUAL PFH_HEADER)
        return()
    endif()
endif()
file(WRITE "${PFH_FLAGS_HEADER}" "${PFH_HEADER}")

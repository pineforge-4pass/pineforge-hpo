//@version=6
strategy("PineForge HPO Scale", initial_capital=10000, default_qty_value=1)
fastLength = input.int(8, "Fast Length", minval=2, maxval=32)
slowLength = input.int(32, "Slow Length", minval=16, maxval=96)
signalLength = input.int(5, "Signal Length", minval=2, maxval=20)
atrLength = input.int(14, "ATR Length", minval=5, maxval=30)
rsiLength = input.int(14, "RSI Length", minval=5, maxval=30)
lowerRsi = input.float(25, "Lower RSI", minval=10, maxval=40)
upperRsi = input.float(75, "Upper RSI", minval=60, maxval=90)
entryThreshold = input.float(0, "Entry Threshold", minval=0, maxval=1)
exitThreshold = input.float(0, "Exit Threshold", minval=0, maxval=1)
stopMultiple = input.float(2, "Stop Multiple", minval=1, maxval=4)
takeMultiple = input.float(3, "Take Multiple", minval=1, maxval=6)
quantity = input.float(1, "Quantity", minval=0.5, maxval=2)
fast = ta.ema(close, fastLength)
slow = ta.ema(close, slowLength)
signalLine = ta.ema(fast - slow, signalLength)
atr = ta.atr(atrLength)
rsi = ta.rsi(close, rsiLength)
if signalLine > atr * entryThreshold and rsi > lowerRsi and rsi < upperRsi
    strategy.entry("L", strategy.long, qty=quantity)
if signalLine < -atr * exitThreshold
    strategy.close("L")
strategy.exit("X", "L", stop=close - atr * stopMultiple, limit=close + atr * takeMultiple)
